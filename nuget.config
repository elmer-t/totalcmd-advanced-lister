<?xml version="1.0" encoding="utf-8"?>
<!-- Repo-local NuGet config: only nuget.org, so a machine-wide packageSourceMapping
     cannot block restore of CsWin32 and the Native AOT ILCompiler/runtime packs. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
